#!/bin/bash
. /lfs/h1/nos/nosofs/noscrub/aijun.zhang/packages/nosofs.v3.6.6/versions/run.ver
module purge 
module load envvar/${envvars_ver:?}
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
if [ ! -d /lfs/h1/nos/ptmp/aijun.zhang/execlog ]; then 
   mkdir -p /lfs/h1/nos/ptmp/aijun.zhang/execlog 
fi 
if [ ! -d /lfs/h1/nos/ptmp/aijun.zhang/rpt/v3.6.6 ]; then 
   mkdir -p /lfs/h1/nos/ptmp/aijun.zhang/rpt/v3.6.6 
fi 
rm -f /lfs/h1/nos/ptmp/aijun.zhang/rpt/v3.6.6/loofs_aws_18_prod.out
rm -f /lfs/h1/nos/ptmp/aijun.zhang/rpt/v3.6.6/loofs_aws_18_prod.err
export LSFDIR=/lfs/h1/nos/nosofs/noscrub/aijun.zhang/packages/nosofs.v3.6.6/pbs 
qsub $LSFDIR/jnos_loofs_aws_18.prod
